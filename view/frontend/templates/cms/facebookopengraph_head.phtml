<?php
/**
 * @var $block \WeltPixel\GoogleCards\Block\FacebookOpenGraph
 *
 * Every value here lands inside a content="..." attribute, so it is escaped with escapeHtmlAttr,
 * or escapeUrl where the value is a url.
 *
 * og:image_alt previously had stripTags as its only filter, which leaves a raw double quote, so a
 * page's Open Graph Image ALT field - editable by anyone who can edit a cms page - escaped the
 * attribute. The app id and the site name had no filter at all. The description also carried the
 * pre-2.2 escapeNotVerified marker, which is gone with the rewrite.
 */
$page = $block->getLayout()->getBlock('cms_page')->getPage();
$fbAppId = trim((string)$block->getAppId());
$siteName = $block->getSiteName();
$pageMetaTitle = $page->getMetaTitle() ? $page->getMetaTitle() : $page->getTitle();
$pageMetaDescription = $page->getMetaDescription();
$pageOgImage = $block->getCmsPageImage($page);
$pageOgImageAlt = $page->getData('og_meta_image_alt');
?>
<!--  facebook open graph -->
<?php if ($fbAppId) : ?>
    <meta property="fb:app_id" content="<?= $block->escapeHtmlAttr($fbAppId) ?>"/>
<?php endif; ?>
<?php if ($siteName) : ?>
<meta property="og:site_name" content="<?= $block->escapeHtmlAttr($siteName) ?>"/>
<?php endif; ?>
<meta property="og:url" content="<?= $block->escapeUrl($block->getCurrentUrl()) ?>" />
<meta property="og:type" content="website"/>
<?php if ($pageMetaTitle) : ?>
<meta property="og:title" content="<?= $block->escapeHtmlAttr($block->stripTags($pageMetaTitle)) ?>" />
<?php endif; ?>
<?php if ($pageOgImage) : ?>
<meta property="og:image" content="<?= $block->escapeUrl($pageOgImage) ?>"/>
<?php endif; ?>
<?php if ($pageOgImageAlt) : ?>
<meta property="og:image_alt" content="<?= $block->escapeHtmlAttr($block->stripTags($pageOgImageAlt)) ?>" />
<?php endif; ?>
<?php if ($pageMetaDescription) : ?>
<meta property="og:description" content="<?= $block->escapeHtmlAttr($block->stripTags($pageMetaDescription)) ?>"/>
<?php endif; ?>
<!--  facebook open graph -->
