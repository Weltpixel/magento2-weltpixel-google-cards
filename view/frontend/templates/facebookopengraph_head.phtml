<?php
/**
 * Every value here lands inside a content="..." attribute, so it is escaped with escapeHtmlAttr,
 * or escapeUrl where the value is a url.
 *
 * og:title previously had stripTags as its only filter, which leaves a raw double quote, so a
 * product name containing one escaped the attribute. The app id, the site name and the retailer id
 * had no filter at all. Note that og:description was already correct in the original, through
 * escapeQuote; escapeHtmlAttr is the current api for the same job.
 */
$_product = $this->getProduct();
$stock = $block->getProductAvailability($_product, true);

$fbAppId = trim((string)$block->getAppId());

$wpCanonicalUrlEnabled = (bool)$_product->getData('wp_enable_canonical_url');
$wpCanonicalUrl = $_product->getData('wp_canonical_url') ?? '';
$productUrl = $_product->getUrlInStore();
if ($wpCanonicalUrlEnabled) {
    $productUrl = $wpCanonicalUrl;
    $urlOptions = parse_url($wpCanonicalUrl);
    if (!isset($urlOptions['scheme'])) {
        $productUrl = $block->getBaseUrl() . $wpCanonicalUrl;
    }
}
?>
<!--  facebook open graph -->
<?php if ($fbAppId) : ?>
    <meta property="fb:app_id" content="<?= $block->escapeHtmlAttr($fbAppId) ?>"/>
<?php endif; ?>
<meta property="og:site_name" content="<?= $block->escapeHtmlAttr($block->getSiteName()) ?>"/>
<meta property="og:type" content="product"/>
<meta property="og:title" content="<?= $block->escapeHtmlAttr($block->stripTags($_product->getName())) ?>"/>
<meta property="og:image" content="<?= $block->escapeUrl($block->getImage($_product, 'weltpixel_googlecards_product_image')->getImageUrl()) ?>"/>
<meta property="og:description" content="<?= $block->escapeHtmlAttr($block->stripTags($block->getDescription($_product))) ?>"/>
<meta property="og:url" content="<?= $block->escapeUrl($productUrl) ?>"/>
<meta property="product:price:amount" content="<?= $block->escapeHtmlAttr($this->getPrice()) ?>"/>
<meta property="product:price:currency" content="<?= $block->escapeHtmlAttr($block->getCurrencyCode()) ?>"/>
<meta property="product:availability" content="<?= $block->escapeHtmlAttr($stock) ?>"/>
<meta property="product:retailer_item_id" content="<?= $block->escapeHtmlAttr($block->getRetailerId($_product)) ?>"/>
<!--  facebook open graph -->
