<?php
/**
 * The json-ld document is assembled as a php array and emitted with json_encode.
 *
 * It used to be written by hand, with each value passed through escapeQuote(stripTags()). Neither
 * of those escapes a control character, so a description containing a newline - which the shipped
 * sample data does - produced json that no parser accepts, and the Product rich result was dropped
 * on every product page. escapeQuote also wrote html entities into json, where nothing ever decodes
 * them, so a size of 4" reached Google as 4&quot;.
 *
 * json_encode escapes quotes, backslashes and control characters correctly, and JSON_HEX_TAG makes
 * the < and > of a </script> unrepresentable, so no value can close the surrounding script element.
 * stripTags is kept on the free text values because structured data should carry plain text, not
 * because it is load bearing for safety any more.
 */
$_product = $this->getProduct();
$_brand = $this->getBrand($_product) ?? '';
$_sku = $this->getSku($_product) ?? '';
$_mpn = $this->getMpn($_product) ?? '';
$_gtin = $this->getGtin($_product) ?? '';
$_itemCondition = $this->getItemCondition($_product);

$reviewsFormat = $this->getReviewsFormat();

$summaryModel = $block->getReviewSummary();
$reviewCount = $summaryModel->getReviewsCount();
if (!$reviewCount) {
    $reviewCount = 0;
}
$ratingSummary = ($summaryModel->getRatingSummary()) ? $summaryModel->getRatingSummary() : 20;
$wpCanonicalUrlEnabled = (bool)$_product->getData('wp_enable_canonical_url');
$wpCanonicalUrl = $_product->getData('wp_canonical_url') ?? '';
$productUrl = $_product->getUrlInStore();
if ($wpCanonicalUrlEnabled) {
    $productUrl = $wpCanonicalUrl;
    $urlOptions = parse_url($wpCanonicalUrl);
    if (!isset($urlOptions['scheme'])) {
        $productUrl = $block->getBaseUrl() . $wpCanonicalUrl;
    }
}

$jsonFlags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT;

$googleCardsData = [
    '@context' => 'https://schema.org/',
    '@type' => 'Product',
    'name' => $block->stripTags($_product->getName()),
    'image' => $block->stripTags(
        $block->getImage($_product, 'weltpixel_googlecards_product_image')->getImageUrl()
    ),
    'description' => $block->stripTags($block->getDescription($_product)),
];

if (strlen(trim($_brand))) {
    $googleCardsData['brand'] = [
        '@type' => 'Brand',
        'name' => $block->stripTags($_brand),
    ];
}
if (strlen(trim($_sku))) {
    $googleCardsData['sku'] = $block->stripTags($_sku);
}
if (strlen(trim($_mpn))) {
    $googleCardsData['mpn'] = $block->stripTags($_mpn);
}
if (strlen(trim($_gtin))) {
    $googleCardsData['gtin13'] = $block->stripTags($_gtin);
}

if ($reviewCount) {
    if ($reviewsFormat != 0) {
        $googleCardsData['aggregateRating'] = [
            '@type' => 'AggregateRating',
            'bestRating' => 5,
            'worstRating' => 1,
            'ratingValue' => (string)($ratingSummary / 20),
            'reviewCount' => (string)$reviewCount,
        ];
    }
    if ($reviewsFormat == 2) {
        $reviews = $block->getReviews();
        if ($reviews) {
            $reviewItems = [];
            foreach ($reviews as $reviewItem) {
                $reviewItems[] = [
                    '@type' => 'Review',
                    'reviewRating' => [
                        '@type' => 'Rating',
                        'ratingValue' => (string)$reviewItem->getRating(),
                    ],
                    'name' => $block->stripTags($reviewItem->getTitle()),
                    'author' => [
                        '@type' => 'Person',
                        'name' => $block->stripTags($reviewItem->getNickname()),
                    ],
                    'datePublished' => $this->formatedDate($reviewItem->getCreatedAt()),
                    'reviewBody' => $block->stripTags($reviewItem->getDetail()),
                ];
            }
            $googleCardsData['review'] = $reviewItems;
        }
    }
}

$googleCardsOffer = [
    '@type' => 'Offer',
    'priceCurrency' => $block->getCurrencyCode(),
    'url' => $block->stripTags($productUrl),
    'availability' => $block->getProductAvailability($_product),
    'price' => (string)$this->getPrice(),
];
if ($_product->getSpecialPrice()) {
    $googleCardsOffer['priceValidUntil'] = $this->formatedDate($_product->getSpecialToDate());
}
if ($_itemCondition) {
    $googleCardsOffer['itemCondition'] = 'https://schema.org/' . $_itemCondition;
}
$googleCardsData['offers'] = $googleCardsOffer;
?>

<script type="application/ld+json">
<?= /* @noEscape */ json_encode($googleCardsData, $jsonFlags) ?>
</script>
