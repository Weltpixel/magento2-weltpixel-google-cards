<?php
/**
 * Emitted through json_encode rather than assembled by hand.
 *
 * The label and the link of every crumb previously reached the json string with stripTags only,
 * which removes tags but leaves a raw double quote, so a category name containing one closed the
 * string and everything after it was parsed as json structure - enough to inject a fabricated
 * aggregateRating into the store's rich results. json_encode escapes the quote, and JSON_HEX_TAG
 * means no crumb can close the surrounding script element.
 */
$crumbs = $this->getCrumbs();
$jsonFlags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT;

$itemListElement = [];
if ($crumbs && is_array($crumbs)) {
    $position = 1;
    foreach ($crumbs as $crumbData) {
        $itemListElement[] = [
            '@type' => 'ListItem',
            'position' => $position,
            'item' => [
                '@id' => $block->stripTags($crumbData['link'] ?? ''),
                'name' => $block->stripTags($crumbData['label'] ?? ''),
            ],
        ];
        $position++;
    }
}

$breadcrumbData = [
    '@context' => 'https://schema.org',
    '@type' => 'BreadcrumbList',
    'itemListElement' => $itemListElement,
];
?>
<?php if (count($itemListElement)) : ?>
    <script type="application/ld+json">
<?= /* @noEscape */ json_encode($breadcrumbData, $jsonFlags) ?>
    </script>
<?php endif; ?>
